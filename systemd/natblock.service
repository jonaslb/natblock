[Unit]
Description=Reconcile scheduled per-device internet access
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/g/natblock
ExecStart=%h/g/natblock/.venv/bin/natblock reconcile --config %h/g/natblock/config.toml
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=%h/.local/state/natblock
